# ---- model -----------------------------------------------------------------
# Any credential the Anthropic SDK resolves works; this is the simplest.
ANTHROPIC_API_KEY=sk-ant-...
HERMES_MODEL=claude-opus-5
# Lower to cut cost per message: low | medium | high | xhigh | max
# HERMES_EFFORT=medium

# ---- mailbox (read-only) ---------------------------------------------------
# Gmail: enable 2FA, then create an App Password and use it here.
# The mailbox is opened readonly and bodies fetched with BODY.PEEK, so nothing
# is ever marked as read.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX

# ---- notifications ---------------------------------------------------------
# Talk to @BotFather to create a bot, then message it once and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- policy gate (deterministic; beats the model score) --------------------
HERMES_INTERVAL=60
HERMES_THRESHOLD=0.7
# Full addresses or bare domains, comma separated.
HERMES_ALWAYS_SENDERS=
HERMES_NEVER_SENDERS=
HERMES_ALWAYS_KEYWORDS=
HERMES_MUTED_CATEGORIES=newsletter,promotion
# Local-time hours to stay silent, e.g. 22-7
HERMES_QUIET_HOURS=
HERMES_DATA_DIR=data
