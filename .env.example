# ---- classifier ------------------------------------------------------------
# auto | anthropic | ollama | offline   (auto = anthropic if a key is set)
HERMES_PROVIDER=auto

# -- anthropic --
ANTHROPIC_API_KEY=sk-ant-...
# ~$18/mo uncached at 100 emails/day, ~$12 cached. Haiku 4.5 is cheaper (~$9)
# but cannot cache this prompt (4096-token minimum), so the gap is small.
HERMES_MODEL=claude-sonnet-5
# Lower to cut cost per message: low | medium | high | xhigh | max
# HERMES_EFFORT=low
# Cache TTL for the standing rules + your corrections: 5m | 1h
HERMES_CACHE_TTL=1h

# -- ollama (free, local, nothing leaves the machine) --
# ollama serve && ollama pull qwen2.5:7b
HERMES_OLLAMA_HOST=http://localhost:11434
HERMES_OLLAMA_MODEL=qwen2.5:7b
HERMES_OLLAMA_TIMEOUT=120

# ---- logging & network -----------------------------------------------------
# DEBUG logs every decision with its score and gate rule.
HERMES_LOG_LEVEL=INFO
# text for a terminal, json for `journalctl -o cat | jq`
HERMES_LOG_FORMAT=text
# Extra attempts on transient failures (connection refused, 408, 429, 5xx).
# Other 4xx are never retried — a bad token fails identically every time.
HERMES_HTTP_RETRIES=3
HERMES_HTTP_BACKOFF=0.5

# ---- mailbox (read-only) ---------------------------------------------------
# Gmail: enable 2FA, then create an App Password and use it here.
# The mailbox is opened readonly and bodies fetched with BODY.PEEK, so nothing
# is ever marked as read.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=your-app-password
IMAP_FOLDER=INBOX

# ---- notifications ---------------------------------------------------------
# Talk to @BotFather to create a bot, then message it once and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- policy gate (deterministic; beats the model score) --------------------
HERMES_INTERVAL=60
HERMES_THRESHOLD=0.7
# Full addresses or bare domains, comma separated.
HERMES_ALWAYS_SENDERS=
HERMES_NEVER_SENDERS=
HERMES_ALWAYS_KEYWORDS=
HERMES_MUTED_CATEGORIES=newsletter,promotion
# Local-time hours to stay silent, e.g. 22-7
HERMES_QUIET_HOURS=
HERMES_DATA_DIR=data
# How many of your corrections reach the prompt (newest first)
HERMES_MAX_EXAMPLES=40
